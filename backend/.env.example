DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me
JWT_SECRET=dev-only-insecure-jwt-key-change-me
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres from docker-compose.yml (host port 5433 to avoid clashing with a local server)
# DATABASE_URL wins over the POSTGRES_* group. In production this is usually
# the connection string your managed database hands you; SSL, connection reuse
# and timeouts are then derived in config/database.py. Optional overrides:
# POSTGRES_HOST, DB_ENGINE, DB_SSLMODE, CONN_MAX_AGE, CONN_HEALTH_CHECKS,
# DB_CONNECT_TIMEOUT, DB_APP_NAME.
DATABASE_URL=postgres://fathom:fathom@localhost:5433/fathom
REDIS_URL=redis://localhost:6380/0

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
LOG_LEVEL=INFO
