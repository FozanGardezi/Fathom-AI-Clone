# Copy to .env and change every secret before deploying anywhere real.
#   cp .env.example .env

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=fathom
POSTGRES_USER=fathom
POSTGRES_PASSWORD=fathom
POSTGRES_PORT=5433

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6380

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=dev-only-insecure-key-change-me
JWT_SECRET=dev-only-insecure-jwt-key-change-me
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Set by compose for the containers; listed here for host-side commands
# (manage.py, pytest) run outside Docker against the published ports.
DATABASE_URL=postgres://fathom:fathom@localhost:5433/fathom
REDIS_URL=redis://localhost:6380/0

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=/api
