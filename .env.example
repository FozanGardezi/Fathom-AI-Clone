# Copy to .env and change every secret before deploying anywhere real.
#   cp .env.example .env

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=fathom
POSTGRES_USER=fathom
POSTGRES_PASSWORD=fathom
POSTGRES_PORT=5433

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6380

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=dev-only-insecure-key-change-me
JWT_SECRET=dev-only-insecure-jwt-key-change-me
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Set by compose for the containers; listed here for host-side commands
# (manage.py, pytest) run outside Docker against the published ports.
#
# DATABASE_URL wins over the POSTGRES_* group above. In production this is
# usually the connection string your managed database hands you. See
# backend/config/database.py for how the connection is assembled.
DATABASE_URL=postgres://fathom:fathom@localhost:5433/fathom
REDIS_URL=redis://localhost:6380/0

# ── Database tuning (all optional) ──────────────────────────────────────────
# Sensible defaults are derived from whether the database is local or remote,
# so none of these need setting unless you want to override them.
#
# POSTGRES_HOST      host, when not using DATABASE_URL       (default localhost)
# DB_ENGINE          Django backend             (default django.db.backends.postgresql)
# DB_SSLMODE         prefer locally, require for a remote host
# CONN_MAX_AGE       seconds to reuse a connection; 0 locally, 60 remote.
#                    Set to 0 on serverless platforms, where every invocation
#                    is a fresh process.
# CONN_HEALTH_CHECKS re-check a reused connection before handing it out;
#                    on whenever CONN_MAX_AGE > 0
# DB_CONNECT_TIMEOUT seconds before giving up on connecting       (default 10)
# DB_APP_NAME        label in pg_stat_activity       (default fathom-backend)

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=/api
