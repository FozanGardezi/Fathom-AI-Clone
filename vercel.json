{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
    "backend": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "backend/config/wsgi.py"
    }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}