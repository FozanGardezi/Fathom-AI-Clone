# Raw hook payload dumps and per-session bookkeeping for the capture hook.
# The captured logs themselves live in .agent-logs/ and ARE committed.
.claude/hook-debug/
.claude/hook-state/

# Environment files - only .env.example is tracked
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
.DS_Store

# Django
staticfiles/
media/
*.sqlite3
